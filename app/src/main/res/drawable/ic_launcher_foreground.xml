<?xml version="1.0" encoding="utf-8"?>
<!-- seven stars, one per app, joined into a constellation and circled by a tilted orbit.
     Hora orange, Consensus blue, Augur violet, Annales stamp rose, Kalendae moon gold,
     Caelum the brightest in white, Fidelis aurora green.
     Everything stays inside the 66dp safe zone so no launcher mask crops it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- tilted orbit: bright on the near side, fading on the far side -->
    <group android:rotation="-22" android:pivotX="54" android:pivotY="54">
        <path android:strokeWidth="0.9"
            android:pathData="M22,54a32,13 0 1,0 64,0a32,13 0 1,0 -64,0">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="54" android:startY="41"
                    android:endX="54" android:endY="67"
                    android:startColor="#14FFFFFF"
                    android:endColor="#73FFFFFF" />
            </aapt:attr>
        </path>
    </group>

    <!-- constellation lines, in the hub's order: Hora, Consensus, Augur, Annales, Kalendae, Caelum, Fidelis -->
    <path android:strokeColor="#59FFFFFF" android:strokeWidth="0.7"
        android:strokeLineCap="round" android:strokeLineJoin="round"
        android:pathData="M36,44L52,32L69,38L75,56L63,72L43,68L31,57Z" />

    <!-- soft glows -->
    <path android:pathData="M27,44a9,9 0 1,0 18,0a9,9 0 1,0 -18,0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="36" android:centerY="44" android:gradientRadius="9"
                android:startColor="#80FF9A3C" android:endColor="#00FF9A3C" />
        </aapt:attr>
    </path>
    <path android:pathData="M44,32a8,8 0 1,0 16,0a8,8 0 1,0 -16,0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="52" android:centerY="32" android:gradientRadius="8"
                android:startColor="#807FB8FF" android:endColor="#007FB8FF" />
        </aapt:attr>
    </path>
    <path android:pathData="M61,38a8,8 0 1,0 16,0a8,8 0 1,0 -16,0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="69" android:centerY="38" android:gradientRadius="8"
                android:startColor="#80C3A6FF" android:endColor="#00C3A6FF" />
        </aapt:attr>
    </path>
    <path android:pathData="M67,56a8,8 0 1,0 16,0a8,8 0 1,0 -16,0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="75" android:centerY="56" android:gradientRadius="8"
                android:startColor="#80F28B9B" android:endColor="#00F28B9B" />
        </aapt:attr>
    </path>
    <path android:pathData="M55,72a8,8 0 1,0 16,0a8,8 0 1,0 -16,0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="63" android:centerY="72" android:gradientRadius="8"
                android:startColor="#80F5E3A1" android:endColor="#00F5E3A1" />
        </aapt:attr>
    </path>
    <path android:pathData="M31,68a12,12 0 1,0 24,0a12,12 0 1,0 -24,0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="43" android:centerY="68" android:gradientRadius="12"
                android:startColor="#99FFFFFF" android:endColor="#00FFFFFF" />
        </aapt:attr>
    </path>
    <path android:pathData="M23,57a8,8 0 1,0 16,0a8,8 0 1,0 -16,0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="31" android:centerY="57" android:gradientRadius="8"
                android:startColor="#807FE0C4" android:endColor="#007FE0C4" />
        </aapt:attr>
    </path>

    <!-- four-point sparkles with curved sides -->
    <path android:fillColor="#FFB067"
        android:pathData="M36,39.5Q36,44 40.5,44Q36,44 36,48.5Q36,44 31.5,44Q36,44 36,39.5Z" />
    <path android:fillColor="#9CCAFF"
