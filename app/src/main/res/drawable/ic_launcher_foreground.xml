<?xml version="1.0" encoding="utf-8"?>
<!-- five stars, one per app, joined into a constellation and circled by a tilted orbit.
     Hora orange, Kalendae moon gold, Consensus blue, Augur violet, and Caelum the brightest, in white.
     Everything stays inside the 66dp safe zone so no launcher mask crops it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- tilted orbit: bright on the near side, fading on the far side -->
    <group android:rotation="-22" android:pivotX="54" android:pivotY="54">
        <path android:strokeWidth="0.9"
            android:pathData="M22,54a32,13 0 1,0 64,0a32,13 0 1,0 -64,0">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="54" android:startY="41"
                    android:endX="54" android:endY="67"
                    android:startColor="#14FFFFFF"
                    android:endColor="#73FFFFFF" />
            </aapt:attr>
        </path>
    </group>

    <!-- constellation lines -->
    <path android:strokeColor="#59FFFFFF" android:strokeWidth="0.7"
        android:strokeLineCap="round" android:strokeLineJoin="round"
        android:pathData="M40,41L61,35L72,54L57,70L38,63Z" />

    <!-- soft glows -->
    <path android:pathData="M30,41a10,10 0 1,0 20,0a10,10 0 1,0 -20,0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="40" android:centerY="41" android:gradientRadius="10"
                android:startColor="#80FF9A3C" android:endColor="#00FF9A3C" />
        </aapt:attr>
    </path>
    <path android:pathData="M52,35a9,9 0 1,0 18,0a9,9 0 1,0 -18,0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="61" android:centerY="35" android:gradientRadius="9"
                android:startColor="#80F5E3A1" android:endColor="#00F5E3A1" />
        </aapt:attr>
    </path>
    <path android:pathData="M63,54a9,9 0 1,0 18,0a9,9 0 1,0 -18,0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="72" android:centerY="54" android:gradientRadius="9"
                android:startColor="#807FB8FF" android:endColor="#007FB8FF" />
        </aapt:attr>
    </path>
    <path android:pathData="M48,70a9,9 0 1,0 18,0a9,9 0 1,0 -18,0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="57" android:centerY="70" android:gradientRadius="9"
                android:startColor="#80C3A6FF" android:endColor="#00C3A6FF" />
        </aapt:attr>
    </path>
    <path android:pathData="M25,63a13,13 0 1,0 26,0a13,13 0 1,0 -26,0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="38" android:centerY="63" android:gradientRadius="13"
                android:startColor="#99FFFFFF" android:endColor="#00FFFFFF" />
        </aapt:attr>
    </path>

    <!-- four-point sparkles with curved sides -->
    <path android:fillColor="#FFB067"
        android:pathData="M40,36Q40,41 45,41Q40,41 40,46Q40,41 35,41Q40,41 40,36Z" />
    <path android:fillColor="#F8EAB4"
        android:pathData="M61,31Q61,35 65,35Q61,35 61,39Q61,35 57,35Q61,35 61,31Z" />
    <path android:fillColor="#9CCAFF"
        android:pathData="M72,49.5Q72,54 76.5,54Q72,54 72,58.5Q72,54 67.5,54Q72,54 72,49.5Z" />
    <path android:fillColor="#D4BEFF"
        android:pathData="M57,66Q57,70 61,70Q57,70 57,74Q57,70 53,70Q57,70 57,66Z" />
    <path android:fillColor="#FFFFFF"
        android:pathData="M38,55.5Q38,63 45.5,63Q38,63 38,70.5Q38,63 30.5,63Q38,63 38,55.5Z" />

    <!-- bright cores -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M39.1,41a0.9,0.9 0 1,0 1.8,0a0.9,0.9 0 1,0 -1.8,0
                          M60.2,35a0.8,0.8 0 1,0 1.6,0a0.8,0.8 0 1,0 -1.6,0
                          M71.2,54a0.8,0.8 0 1,0 1.6,0a0.8,0.8 0 1,0 -1.6,0
                          M56.2,70a0.8,0.8 0 1,0 1.6,0a0.8,0.8 0 1,0 -1.6,0
                          M36.8,63a1.2,1.2 0 1,0 2.4,0a1.2,1.2 0 1,0 -2.4,0" />
</vector>
