    <path android:fillColor="#FFFFFF"
        android:pathData="M43,61Q43,68 50,68Q43,68 43,75Q43,68 36,68Q43,68 43,61Z" />
    <path android:fillColor="#A6EFD9"
        android:pathData="M31,53Q31,57 35,57Q31,57 31,61Q31,57 27,57Q31,57 31,53Z" />

    <!-- bright cores -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M35.1,44a0.9,0.9 0 1,0 1.8,0a0.9,0.9 0 1,0 -1.8,0
                          M51.2,32a0.8,0.8 0 1,0 1.6,0a0.8,0.8 0 1,0 -1.6,0
                          M68.2,38a0.8,0.8 0 1,0 1.6,0a0.8,0.8 0 1,0 -1.6,0
                          M74.2,56a0.8,0.8 0 1,0 1.6,0a0.8,0.8 0 1,0 -1.6,0
