                          M41.8,68a1.2,1.2 0 1,0 2.4,0a1.2,1.2 0 1,0 -2.4,0
                          M30.2,57a0.8,0.8 0 1,0 1.6,0a0.8,0.8 0 1,0 -1.6,0" />
</vector>
